# Database Configuration (Prisma)
DATABASE_URL=mysql://root:@127.0.0.1:3306/db_sipmas

# SMTP Configuration (Email OTP & Notifikasi)
# Default dev: Menggunakan MailHog (di Docker) atau Mailpit/Laragon (di host lokal)
# Nilai default jika dikosongkan: host localhost / mailhog, port 1025, tanpa auth.
#
# Contoh pengiriman email asli via Google Mail (Gmail SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=akun_anda@gmail.com
# SMTP_PASS=app_password_16_huruf_tanpa_spasi   # Buat di Google Account -> Security -> 2-Step Verification -> App Passwords
# SMTP_FROM="SIPMAS Layanan" <akun_anda@gmail.com> # Opsional: jika kosong, default "<label>" <noreply@sipmas.go.id>
#
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Service URLs & Ports
PORT=5001
NLP_SERVICE_URL=http://127.0.0.1:5000
NEXT_PUBLIC_API_URL=http://localhost:5001

# Security & Authentication (JWT & Microservice API Keys)
# WAJIB: Buat string acak kuat (contoh: openssl rand -base64 64)
JWT_SECRET="ganti-dengan-kunci-jwt-acak-yang-kuat"
FRONTEND_URL="http://localhost:3000"
# Ambang Keyakinan NLP (Fase 17.3 - default 0.5)
NLP_MIN_CONFIDENCE=0.5

# Reverse Proxy (Fase 15.4)
# Isi hanya jika backend berada di belakang reverse proxy seperti Nginx/Caddy (misal: TRUST_PROXY=1)
# TRUST_PROXY=

# Admin Bootstrap (Prisma Seed - Fase 9)
ADMIN_EMAIL="admin@sipmas.id"
ADMIN_PASSWORD="AdminSIPMAS2026!"
ADMIN_NIK="0000000000000001"
ADMIN_NAMA="Administrator SIPMAS"

# Monitoring & Error Tracking (Optional - Sentry)
# Kosongkan jika tidak menggunakan Sentry; aplikasi tetap berjalan normal
SENTRY_DSN=""

# Object Storage Upload Foto (Optional - MinIO / S3)
# Kosongkan jika menggunakan penyimpanan lokal disk (public/uploads); aplikasi otomatis fallback ke lokal
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="sipmas-uploads"
S3_REGION="us-east-1"
